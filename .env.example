# PitchPilot AI Configuration
# Support for either Google Gemini or Anthropic Claude API:
# If no key is set, PitchPilot operates in intelligent offline demo mode with instant responses.

# Gemini API Key (Recommended for fast inference)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Optional alternative)
ANTHROPIC_API_KEY=your_claude_api_key_here

# Generic AI Key (Works for either Gemini or Claude)
AI_API_KEY=your_api_key_here
